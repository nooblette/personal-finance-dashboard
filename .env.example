# Supabase
# 값은 Supabase Dashboard > Project Settings > API Keys 에서 복사.
# - Publishable key (sb_publishable_...) 를 VITE_SUPABASE_PUBLISHABLE_KEY 에 넣는다.
# - Secret key (sb_secret_...) 는 절대 여기에 넣지 말 것 (브라우저 노출 = RLS 우회).
# 실제 값은 .env.local 에 채우고 (git 미추적), 이 파일은 키 목록만 공유한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
